{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proofpick-v2-9d-independent-online-case-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "domain_id", "query", "target_model", "region", "allowed_domains", "target_fields", "expected_safety", "evaluation_state", "run_count"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^web2-(mon|lap|hph)-[0-9]{3}$"},
    "domain_id": {"enum": ["monitor", "laptop", "headphone"]},
    "query": {"type": "string", "minLength": 8},
    "target_model": {"type": "string", "minLength": 2},
    "region": {"type": "string", "pattern": "^[A-Z]{2,6}$"},
    "allowed_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "target_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "expected_safety": {
      "type": "object", "additionalProperties": false,
      "required": ["official_domain_only", "exact_model_required", "exact_region_required_for_usable", "lineage_complete_if_evidence", "trusted_eligible", "checker_entries"],
      "properties": {
        "official_domain_only": {"const": true}, "exact_model_required": {"const": true},
        "exact_region_required_for_usable": {"const": true}, "lineage_complete_if_evidence": {"const": true},
        "trusted_eligible": {"const": false}, "checker_entries": {"const": 0}
      }
    },
    "evaluation_state": {"const": "frozen_unrun"}, "run_count": {"const": 0}
  }
}
